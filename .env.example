# OpenRouter API — получить на https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель ИИ (Brain) на OpenRouter.
# Бесплатные варианты, если текущая модель перегружена (ошибка 429):
# - google/gemma-4-31b-it:free (по умолчанию)
# - qwen/qwen-2.5-7b-instruct:free (очень быстрая, отлично говорит на русском)
# - google/gemma-2-9b-it:free (сбалансированная и быстрая)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Опционально: выбор голоса Silero
# aidar (мужской), baya (женский), kseniya (женский), xenia (женский)
SILERO_SPEAKER=aidar

# Опционально: модель Whisper
# tiny / base / small / medium / turbo / large-v3
WHISPER_MODEL=turbo

# Опционально: уровень логирования (DEBUG / INFO / WARNING / ERROR)
JARVIS_LOG_LEVEL=INFO

# Опционально: устройство для Whisper (cuda / cpu)
WHISPER_DEVICE=cuda

# Опционально: тип вычислений Whisper (float16 / int8 / int8_float16 / float32)
WHISPER_COMPUTE=int8_float16

# Опционально: чувствительность микрофона (чем выше, тем громче нужно говорить; по умолчанию 0.01)
# SILENCE_THRESHOLD=0.01

# Опционально: задержка после окончания речи (в секундах) до завершения записи
# SILENCE_DURATION=1.5

# Зеркало Hugging Face для быстрой загрузки моделей без зависаний
HF_ENDPOINT=https://hf-mirror.com